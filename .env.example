# Copy this file to .env and edit it. .env is git-ignored: never commit it.

# --- Your business (the AI reads this to score leads and write messages; also editable in Settings) ---
MY_BUSINESS=We build modern websites and WhatsApp automation for small local businesses.
# Name and tagline shown in the dashboard header (also editable in Settings)
BRAND_NAME=Lead Agent
BRAND_TAGLINE=
# Country calling code for local numbers that start with 0 (e.g. 44 UK, 1 US, 91 India, 92 Pakistan, 971 UAE).
# Leave empty to require full international numbers.
DEFAULT_COUNTRY_CODE=

# --- Security (set these!) ---
# Dashboard password. Empty = no login (only OK if port 8000 is reachable from this computer alone).
DASHBOARD_PASSWORD=change-me-to-a-long-password
# API key for the WAHA WhatsApp gateway; also the WAHA dashboard password (user: admin). Use a long random value.
WAHA_API_KEY=change-me-to-a-long-random-key
# Shared secret on the webhook URL WAHA calls (docker-compose.yml adds it). Empty = webhook accepts anyone.
WEBHOOK_TOKEN=change-me-to-another-random-value

# --- Local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- WhatsApp gateway (WAHA) ---
# Image: devlikeapro/waha:gows (Intel/AMD PCs) or devlikeapro/waha:gows-arm (Apple Silicon, ARM)
WAHA_IMAGE=devlikeapro/waha:gows
WAHA_URL=http://localhost:3000
WAHA_SESSION=default

# --- Optional: official WhatsApp Cloud API (see README "Official WhatsApp Cloud API") ---
# waha (default, linked normal account, unofficial) or cloud (official Meta API, no ban risk)
WHATSAPP_PROVIDER=waha
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
# Any string you choose; paste the same into Meta's webhook setup
WA_CLOUD_VERIFY_TOKEN=
# Meta app secret: used to check X-Hub-Signature-256 on /webhook/cloud
WA_CLOUD_APP_SECRET=
# Approved template (one {{1}} body variable) used for first contact outside the 24-hour window
WA_CLOUD_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=en

# --- Safety limits (also editable in Settings). Start low on a new number. ---
DAILY_SEND_LIMIT=15
MIN_SECONDS_BETWEEN_SENDS=45
FOLLOWUP_DAYS=3,7
# Sending window, local time. SEND_SCHEDULE (set from Settings) can hold per-weekday hours.
SEND_START=09:00
SEND_END=20:00
OPTOUT_ENABLED=1
OPTOUT_LINE=Reply STOP to opt out

# --- Optional: phone push when a lead replies (empty = off). Use a long random topic, subscribe in the free
# "ntfy" app. Only "New reply from <name>" is sent, never the message text.
NTFY_TOPIC=

# --- Optional: Google Places lead source (official API; empty = only OpenStreetMap is offered) ---
GOOGLE_PLACES_API_KEY=

# --- Optional: CRM integration (see docs/INTEGRATIONS.md) ---
# Bearer key for the REST API under /api/v1. Empty = API disabled. Use a long random value.
API_KEY=
# Lead Agent POSTs events (lead.created, message.sent, reply.received...) here. Empty = off.
CRM_WEBHOOK_URL=
# Signs each webhook (header X-LeadAgent-Signature: sha256=<hmac>) so your CRM/n8n can verify it.
CRM_WEBHOOK_SECRET=
